<+>@import url('https://fonts.googleapis.com/css2?family=Open+Sans:wght@700&display=swap');\r\n@import url('https://fonts.googleapis.com/css2?family=Roboto+Slab:wght@700&display=swap');\r\n\r\nbody{\r\n  height: 80vh;\r\n  justify-content: center;\r\n  align-items: center;\r\n}\r\n\r\n/* image temporaire css tempo*/\r\nimg{\r\n  height: 99%;\r\n  width: 99%;\r\n}\r\n\r\nnav {\r\n  display: flex;\r\n  box-shadow: 10px 1px 5px #b9b9b9;\r\n  background-color: rgb(255, 255, 255);\r\n  flex-direction: row;\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 5;\r\n  padding: 18px 0px;\r\n}\r\n\r\nnav > div{\r\n  display: flex;\r\n  position : relative;\r\n  align-items: center;\r\n}\r\n\r\nnav img{\r\n  margin-left: 8%;\r\n  height: 16%;\r\n  width: 16%;\r\n}\r\n\r\nnav h1{\r\n  margin-top: 2%;\r\n  margin-left: 3%;\r\n  margin-right: 15%;\r\n  font-family: 'Open Sans', sans-serif;\r\n  font-size: 25px;\r\n}\r\n\r\nnav div a {\r\n  color: rgb(0, 0, 0);\r\n  padding: 15px 20px;\r\n  font-family: 'Open Sans', sans-serif;\r\n  font-size: 14px;\r\n  text-decoration: none;\r\n  cursor: pointer;\r\n}\r\n\r\nnav div a:hover{\r\n  color: #F44336;\r\n}\r\n\r\n#actuel{\r\n  color: #F44336;\r\n}\r\n\r\n.submenu{\r\n  display : none;\r\n  background-color: #f9f9f9;\r\n  position:absolute;\r\n  box-shadow: 0px 8px 16px 0px rgba(0,0,0,0.2);\r\n  margin-top: 314px;\r\n}\r\n\r\nnav div:hover .submenu{\r\n  display : block;\r\n}\r\n\r\n.submenu a {\r\n  color: #ffffff;\r\n  padding: 12px 16px;\r\n  text-decoration: none;\r\n  display: block;\r\n}\r\n.submenu a:hover {\r\n  background-color: #f1f1f1;\r\n  text-decoration : none;  \r\n}\r\n\r\n.connexion{\r\n  position: absolute;\r\n  padding: 10px;\r\n  background-color: #F44336;\r\n  border-radius: 10px 10px;\r\n  color: white;\r\n  text-decoration: none;\r\n  right: 3%;\r\n}\r\n\r\n#connex{\r\n  top: 50%;\r\n}\r\n\r\n.connexion:hover{\r\n  transition: all 0.3s ease;\r\n  transform: scale(0.96);\r\n}\r\n\r\n.burger{\r\n  display: none;\r\n  position: fixed;\r\n  z-index: 5;\r\n  width: 100%;\r\n  background-color: white;\r\n}\r\n\r\n.burger a{\r\n  text-decoration: none;\r\n  color : black;\r\n  padding: 100% 0%;\r\n  font-size: 20px;\r\n}\r\n\r\n#menu2 div{\r\n  border-top : 1px solid black;\r\n  padding: 15px 0%;\r\n}\r\n\r\n#menu2{\r\n  display: none;\r\n  background-color: #ededeb;\r\n}\r\n\r\n.burger:hover #menu2{\r\n  display: block;\r\n}\r\n\r\nh1{\r\n  font-family: 'Roboto Slab', serif;\r\n  font-size: 34px;\r\n}\r\n\r\nfooter{\r\n  background-color: #ffffff;\r\n  padding: 5px 5px;\r\n  color: #000000;\r\n  padding-left: 50px;\r\n  font-weight: bold;\r\n}\r\n\r\n\r\n@media(max-width: 784px){\r\n  .boxes{\r\n    display: block;\r\n    position: static;\r\n  }\r\n\r\n  nav{\r\n    display: none;\r\n  }\r\n\r\n  .burger{\r\n    display: block;\r\n  }\r\n}\r\n\r\n/*\r\nButton\r\n */\r\n\r\ndiv.boutonAlternanceStage {\r\n    display: flex;\r\n}\r\n\r\n.container .buttonStage,\r\n.container .buttonAlternance {\r\n  margin: 0;\r\n}\r\n\r\n.container .buttonStage:hover {\r\n  background: white;\r\n  color: red;\r\n  border: 2px solid #000; /* Couleur de la bordure (noir dans cet exemple) */\r\n}\r\n\r\n\r\n\r\n.container .buttonStage {\r\n  width: 50%;\r\n  font-size: 3vh;\r\n  background: red;\r\n  text-align: center;\r\n  padding: 2%;\r\n  color: black;\r\n  border-bottom-left-radius: 5px;\r\n  border-top-left-radius: 5px;\r\n}\r\n\r\n.container .buttonAlternance {\r\n  width: 50%;\r\n  font-size: 3vh;\r\n  background: black;\r\n  color: white;\r\n  padding: 2%;\r\n  text-align: center;\r\n  border-bottom-right-radius: 5px;\r\n  border-top-right-radius: 5px;\r\n}\r\n\r\n\r\n/*\r\nformulaire\r\n */\r\nform {\r\n  padding-right: 15%;\r\n  padding-bottom: 2%;\r\n  margin-left: 10%;\r\n}\r\n\r\n\r\n\r\n.container{\r\n  max-width: 700px;\r\n  width: 100%;\r\n  background-color: #fff;\r\n  border-radius: 5px;\r\n  margin: 5vh 0 0 25vw;\r\n  box-shadow: 0 5px 10px rgba(0,0,0,0.15);\r\n}\r\n.container .title{\r\n  font-size: 25px;\r\n  font-weight: 500;\r\n  position: relative;\r\n}\r\n.container .title::before{\r\n  content: \"\";\r\n  position: absolute;\r\n  left: 0;\r\n  bottom: 0;\r\n  height: 3px;\r\n  width: 30px;\r\n  border-radius: 5px;\r\n  background-color: #F44336;;\r\n}\r\n.content form .user-details{\r\n  display: flex;\r\n  flex-wrap: wrap;\r\n  justify-content: space-between;\r\n  margin: 20px 0 12px 0;\r\n}\r\nform .user-details .input-box{\r\n  margin-bottom: 15px;\r\n  width: calc(100% / 2 - 20px);\r\n}\r\nform .input-box span.details{\r\n  display: block;\r\n  font-weight: 500;\r\n  margin-bottom: 5px;\r\n}\r\n.user-details .input-box input{\r\n  height: 45px;\r\n  width: 100%;\r\n  outline: none;\r\n  font-size: 16px;\r\n  border-radius: 5px;\r\n  padding-left: 15px;\r\n  border: 1px solid #ccc;\r\n  border-bottom-width: 2px;\r\n  transition: all 0.3s ease;\r\n}\r\n.user-details .input-box input:focus,\r\n.user-details .input-box input:valid{\r\n  border-color: #F44336;\r\n}\r\nform .category{\r\n  display: flex;\r\n  width: 80%;\r\n  margin: 14px 0 ;\r\n  justify-content: space-between;\r\n}\r\n\r\nform .button{\r\n  height: 45px;\r\n  margin: 35px 0\r\n}\r\nform .button input{\r\n  height: 100%;\r\n  width: 100%;\r\n  border-radius: 5px;\r\n  border: none;\r\n  color: #fff;\r\n  font-size: 18px;\r\n  font-weight: 500;\r\n  letter-spacing: 1px;\r\n  cursor: pointer;\r\n  transition: all 0.3s ease;\r\n  background-color: #F44336;\r\n}\r\nform .button input:hover{\r\n  transform: scale(0.97);\r\n  background-color:#F44336;\r\n}\r\n@media(max-width: 584px){\r\n  .container{\r\n    max-width: 100%;\r\n  }\r\n  form .user-details .input-box{\r\n    margin-bottom: 15px;\r\n    width: 100%;\r\n  }\r\n  form .category{\r\n    width: 100%;\r\n  }\r\n  .content form .user-details{\r\n    max-height: 300px;\r\n    overflow-y: scroll;\r\n  }\r\n  .user-details::-webkit-scrollbar{\r\n    width: 5px;\r\n  }\r\n}\r\n@media(max-width: 459px){\r\n  .container .content .category{\r\n    flex-direction: column;\r\n  }\r\n}\r\n
